        <mxCell id="text_0073" value="1" style="text;html=0;whiteSpace=wrap;overflow=visible;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=9.4;fontColor=#286D92;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="15.3450" y="381.1800" width="9.3100" height="11.6400" as="geometry" />
        </mxCell>
        <mxCell id="text_0074" value="Cohort variation is larger" style="text;html=0;whiteSpace=wrap;overflow=visible;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=9.3;fontColor=#172D3B;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="33.0000" y="374.0281" width="114.8800" height="11.9438" as="geometry" />
        </mxCell>
        <mxCell id="text_0075" value="Than model variation in the&#10;tested competitive set" style="text;html=0;whiteSpace=wrap;overflow=visible;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=8.5;fontColor=#596D7A;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
