        </mxCell>
        <mxCell id="text_0084" value="(c) The argument across the study" style="text;html=0;whiteSpace=wrap;overflow=visible;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=8;fontColor=#172D3B;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
