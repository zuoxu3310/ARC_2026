        <mxCell id="text_0081" value="3" style="text;html=0;whiteSpace=wrap;overflow=visible;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=9.4;fontColor=#AC542C;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="353.3900" y="381.1800" width="9.2200" height="11.6400" as="geometry" />
        </mxCell>
        <mxCell id="text_0082" value="Composition helps explain" style="text;html=0;whiteSpace=wrap;overflow=visible;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=9.3;fontColor=#172D3B;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
