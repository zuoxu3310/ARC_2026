        </mxCell>
        <mxCell id="text_0085" value="A higher score alone does not identify a method gain." style="text;html=0;whiteSpace=wrap;overflow=visible;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=10.5;fontColor=#172D3B;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
