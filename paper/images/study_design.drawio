        <mxCell id="text_0077" value="2" style="text;html=0;whiteSpace=wrap;overflow=visible;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=9.4;fontColor=#24786E;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
