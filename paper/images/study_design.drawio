        </mxCell>
        <mxCell id="text_0083" value="The main FLAIR and task-fMRI&#10;score losses" style="text;html=0;whiteSpace=wrap;overflow=visible;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=8.5;fontColor=#596D7A;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
