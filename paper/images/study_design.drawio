        <mxCell id="text_0068" value="One tile per patient; positions are identical across grids." style="text;html=0;whiteSpace=wrap;overflow=visible;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=8.3;fontColor=#596D7A;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
