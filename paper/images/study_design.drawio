        </mxCell>
        <mxCell id="text_0078" value="Scores shift without refitting" style="text;html=0;whiteSpace=wrap;overflow=visible;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=9.3;fontColor=#172D3B;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="202.0000" y="374.0281" width="130.0000" height="11.9438" as="geometry" />
        </mxCell>
        <mxCell id="text_0079" value="Fixed predictions produce&#10;both score gains and losses" style="text;html=0;whiteSpace=wrap;overflow=visible;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=8.5;fontColor=#596D7A;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
